@namespace NorthWind.Sales.Frontend.Views.Components
@inject ICustomerGateway CustomerGateway

@if (IsOpen)
{
    <div class="modal fade show" tabindex="-1" style="display: block; background: rgba(0,0,0,0.5);" role="dialog">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable" role="document">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">
                        <i class="bi bi-search me-2"></i>Búsqueda Inteligente de Clientes
                    </h5>
                    <button type="button" class="btn-close btn-close-white" aria-label="Close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="input-group mb-3">
                        <span class="input-group-text bg-light">
                            🔍
                        </span>
                        <input type="text"
                               class="form-control"
                               placeholder="Buscar por ID, Razón Social o Nombre de Contacto..."
                               value="@SearchTerm"
                               @oninput="OnSearchInputChanged"
                               @onkeydown="OnKeyDown"
                               autofocus />
                        <button class="btn btn-outline-primary" type="button" @onclick="ExecuteSearch" disabled="@IsLoading">
                            Buscar
                        </button>
                    </div>

                    @if (IsLoading)
                    {
                        <div class="text-center py-4">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                            <p class="mt-2 text-muted">Buscando clientes...</p>
                        </div>
                    }
                    else if (PagedCustomers == null || PagedCustomers.Items.Count == 0)
                    {
                        <div class="alert alert-warning text-center my-3">
                            No se encontraron clientes que coincidan con la búsqueda.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover table-striped align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 15%;">ID</th>
                                        <th style="width: 30%;">Razón Social / Empresa</th>
                                        <th style="width: 25%;">Contacto</th>
                                        <th style="width: 20%;">Ubicación</th>
                                        <th style="width: 10%;" class="text-center">Acción</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var customer in PagedCustomers.Items)
                                    {
                                        <tr style="cursor: pointer;" @onclick="() => SelectCustomer(customer)">
                                            <td>
                                                <span class="badge bg-secondary font-monospace">@customer.CustomerId</span>
                                            </td>
                                            <td class="fw-semibold">@customer.CompanyName</td>
                                            <td class="text-muted">@(customer.ContactName ?? "-")</td>
                                            <td>
                                                <small class="text-muted">
                                                    @customer.City@(!string.IsNullOrEmpty(customer.Country) ? $", {customer.Country}" : "")
                                                </small>
                                            </td>
                                            <td class="text-center">
                                                <button type="button"
                                                        class="btn btn-sm btn-success"
                                                        @onclick:stopPropagation="true"
                                                        @onclick="() => SelectCustomer(customer)">
                                                    Seleccionar
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Paginación -->
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <small class="text-muted">
                                Total: <strong>@PagedCustomers.TotalCount</strong> clientes registrados
                            </small>
                            <div class="btn-group" role="group">
                                <button type="button"
                                        class="btn btn-sm btn-outline-secondary"
                                        disabled="@(!PagedCustomers.HasPreviousPage || IsLoading)"
                                        @onclick="PreviousPage">
                                    &laquo; Anterior
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary disabled" disabled>
                                    Página @PagedCustomers.Page de @Math.Max(1, PagedCustomers.TotalPages)
                                </button>
                                <button type="button"
                                        class="btn btn-sm btn-outline-secondary"
                                        disabled="@(!PagedCustomers.HasNextPage || IsLoading)"
                                        @onclick="NextPage">
                                    Siguiente &raquo;
                                </button>
                            </div>
                        </div>
                    }
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" @onclick="CloseModal">Cancelar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    [Parameter]
    public EventCallback<CustomerSearchDto> OnCustomerSelected { get; set; }

    private string SearchTerm { get; set; } = string.Empty;
    private int CurrentPage { get; set; } = 1;
    private const int PageSize = 5;
    private bool IsLoading { get; set; }
    private PagedResult<CustomerSearchDto>? PagedCustomers { get; set; }
    private System.Threading.CancellationTokenSource? _debounceCts;

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && PagedCustomers == null)
        {
            await LoadCustomersAsync();
        }
    }

    private async Task OnSearchInputChanged(ChangeEventArgs e)
    {
        SearchTerm = e.Value?.ToString() ?? string.Empty;
        CurrentPage = 1;

        _debounceCts?.Cancel();
        _debounceCts = new System.Threading.CancellationTokenSource();
        var token = _debounceCts.Token;

        try
        {
            await Task.Delay(300, token);
            if (!token.IsCancellationRequested)
            {
                await LoadCustomersAsync();
            }
        }
        catch (TaskCanceledException)
        {
            // Ignore cancellation from debounce
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ExecuteSearch();
        }
        else if (e.Key == "Escape")
        {
            await CloseModal();
        }
    }

    private async Task ExecuteSearch()
    {
        CurrentPage = 1;
        await LoadCustomersAsync();
    }

    private async Task PreviousPage()
    {
        if (PagedCustomers != null && PagedCustomers.HasPreviousPage)
        {
            CurrentPage--;
            await LoadCustomersAsync();
        }
    }

    private async Task NextPage()
    {
        if (PagedCustomers != null && PagedCustomers.HasNextPage)
        {
            CurrentPage++;
            await LoadCustomersAsync();
        }
    }

    private async Task LoadCustomersAsync()
    {
        IsLoading = true;
        StateHasChanged();

        try
        {
            PagedCustomers = await CustomerGateway.SearchCustomersAsync(
                searchTerm: SearchTerm,
                page: CurrentPage,
                pageSize: PageSize);
        }
        catch (Exception)
        {
            PagedCustomers = new PagedResult<CustomerSearchDto>([], 0, CurrentPage, PageSize);
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task SelectCustomer(CustomerSearchDto customer)
    {
        await OnCustomerSelected.InvokeAsync(customer);
        await CloseModal();
    }

    private async Task CloseModal()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }
}
