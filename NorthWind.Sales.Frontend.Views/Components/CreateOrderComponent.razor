<EditForm Model="Order" OnValidSubmit="Order.Send">
    <ModelValidator Validator="Order.Validator" @ref="Order.ModelValidatorComponentReference" />
    <ValidationSummary />

    @if (!string.IsNullOrWhiteSpace(Order.WarningMessage))
    {
        <div class="alert alert-warning alert-dismissible fade show d-flex align-items-center" role="alert">
            <span class="me-2">⚠️</span>
            <div>@Order.WarningMessage</div>
            <button type="button" class="btn-close" @onclick="() => Order.WarningMessage = string.Empty"></button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Order.InformationMessage))
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center" role="alert">
            <span class="me-2">✅</span>
            <div>@Order.InformationMessage</div>
            <button type="button" class="btn-close" @onclick="() => Order.Reset()"></button>
        </div>
    }

    <!-- Sección 1: Datos del Cliente y Facturación -->
    <div class="card mb-4 shadow-sm border-0">
        <div class="card-header bg-light d-flex justify-content-between align-items-center py-3">
            <h5 class="card-title mb-0 text-primary">
                👤 Datos del Cliente y Envío
            </h5>
            <button type="button" class="btn btn-primary btn-sm" @onclick="OpenCustomerModal">
                🔍 Buscar Cliente
            </button>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label fw-semibold" for="customerId">@CreateOrderMessages.CustomerIdLabel</label>
                    <div class="input-group">
                        <InputText class="form-control" id="customerId" placeholder="@CreateOrderMessages.CustomerIdLabel" @bind-Value="Order.CustomerId" />
                        <button type="button" class="btn btn-outline-secondary" title="Buscar cliente" @onclick="OpenCustomerModal">
                            🔍
                        </button>
                    </div>
                    <ValidationMessage For="() => Order.CustomerId" />
                </div>
                <div class="col-md-8">
                    <label class="form-label fw-semibold">Razón Social / Empresa</label>
                    <input type="text" class="form-control bg-light" value="@Order.CustomerName" placeholder="Seleccione un cliente para autocompletar..." readonly />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold" for="shipAddress">@CreateOrderMessages.ShipAddressLabel</label>
                    <InputText class="form-control" id="shipAddress" placeholder="@CreateOrderMessages.ShipAddressLabel" @bind-Value="Order.ShipAddress" />
                    <ValidationMessage For="() => Order.ShipAddress" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold" for="shipCity">@CreateOrderMessages.ShipCityLabel</label>
                    <InputText class="form-control" id="shipCity" placeholder="@CreateOrderMessages.ShipCityLabel" @bind-Value="Order.ShipCity" />
                    <ValidationMessage For="() => Order.ShipCity" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold" for="shipPostalCode">@CreateOrderMessages.ShipPostalCodeLabel</label>
                    <InputText class="form-control" id="shipPostalCode" placeholder="@CreateOrderMessages.ShipPostalCodeLabel" @bind-Value="Order.ShipPostalCode" />
                    <ValidationMessage For="() => Order.ShipPostalCode" />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold" for="shipCountry">@CreateOrderMessages.ShipCountryLabel</label>
                    <InputText class="form-control" id="shipCountry" placeholder="@CreateOrderMessages.ShipCountryLabel" @bind-Value="Order.ShipCountry" />
                    <ValidationMessage For="() => Order.ShipCountry" />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Contacto de Referencia</label>
                    <input type="text" class="form-control bg-light" value="@Order.ContactName" placeholder="Contacto..." readonly />
                </div>
            </div>
        </div>
    </div>

    <!-- Sección 2: Detalle de Productos (Carrito de Facturación) -->
    <div class="card mb-4 shadow-sm border-0">
        <div class="card-header bg-light d-flex justify-content-between align-items-center py-3">
            <h5 class="card-title mb-0 text-success">
                🛒 Detalle de la Orden / Factura
            </h5>
            <button type="button" class="btn btn-success btn-sm" @onclick="OpenAddProductModal">
                ➕ Buscar Producto
            </button>
        </div>
        <div class="card-body p-0">
            @if (Order.OrderDetails.Count == 0)
            {
                <div class="p-5 text-center text-muted">
                    <p class="fs-4 mb-2">📦 El carrito está vacío</p>
                    <p class="mb-3">Haga clic en <strong>"Buscar Producto"</strong> para agregar artículos con stock disponible.</p>
                    <button type="button" class="btn btn-outline-success" @onclick="OpenAddProductModal">
                        ➕ Buscar Producto en Inventario
                    </button>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover table-striped mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 8%;">ID</th>
                                <th style="width: 32%;">Producto</th>
                                <th style="width: 15%;" class="text-end">Precio Unitario</th>
                                <th style="width: 12%;" class="text-center">Stock Disp.</th>
                                <th style="width: 15%;" class="text-center">Cantidad</th>
                                <th style="width: 15%;" class="text-end">Total Línea</th>
                                <th style="width: 15%;" class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Order.OrderDetails)
                            {
                                <tr>
                                    <td>
                                        <span class="badge bg-secondary font-monospace">@item.ProductId</span>
                                    </td>
                                    <td>
                                        <div class="fw-semibold">
                                            @(!string.IsNullOrEmpty(item.ProductName) ? item.ProductName : $"Producto #{item.ProductId}")
                                        </div>
                                    </td>
                                    <td class="text-end font-monospace">
                                        <input type="text"
                                               class="form-control form-control-sm text-end bg-light font-monospace"
                                               value="@($"$ {item.UnitPrice:N2}")"
                                               readonly />
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @(item.UnitsInStock > 0 ? "bg-info text-dark" : "bg-danger")">
                                            @item.UnitsInStock u.
                                        </span>
                                    </td>
                                    <td>
                                        <div class="input-group input-group-sm justify-content-center">
                                            <button type="button"
                                                    class="btn btn-outline-secondary"
                                                    disabled="@(item.Quantity <= 1)"
                                                    @onclick="() => Order.DecrementQuantity(item)">
                                                -
                                            </button>
                                            <input type="number"
                                                   class="form-control text-center @(item.HasStockExceeded ? "is-invalid" : "")"
                                                   style="max-width: 70px;"
                                                   min="1"
                                                   max="@item.UnitsInStock"
                                                   value="@item.Quantity"
                                                   @onchange="(e) => OnQuantityChanged(item, e)" />
                                            <button type="button"
                                                    class="btn btn-outline-secondary"
                                                    disabled="@(item.HasStockReached)"
                                                    @onclick="() => Order.IncrementQuantity(item)">
                                                +
                                            </button>
                                        </div>
                                        @if (item.HasStockExceeded)
                                        {
                                            <div class="text-danger small text-center mt-1">
                                                Excede stock (@item.UnitsInStock)
                                            </div>
                                        }
                                    </td>
                                    <td class="text-end font-monospace fw-bold text-success">
                                        <input type="text"
                                               class="form-control form-control-sm text-end bg-light font-monospace fw-bold text-success"
                                               value="@($"$ {item.Total:N2}")"
                                               readonly />
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm">
                                            <button type="button"
                                                    class="btn btn-outline-primary"
                                                    title="Cambiar producto"
                                                    @onclick="() => OpenChangeProductModal(item)">
                                                🔄 Cambiar
                                            </button>
                                            <button type="button"
                                                    class="btn btn-outline-danger"
                                                    title="Eliminar producto"
                                                    @onclick="() => Order.RemoveOrderDetailItem(item)">
                                                🗑️ Eliminar
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- Sección 3: Panel de Totales en Tiempo Real y Emisión -->
    <div class="row g-4 align-items-start">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 bg-light">
                <div class="card-body">
                    <h6 class="card-title text-secondary mb-3">ℹ️ Información de Facturación</h6>
                    <ul class="list-unstyled mb-0 small text-muted">
                        <li>• Los precios unitarios y totales son calculados automáticamente.</li>
                        <li>• Se aplica una tasa fija de <strong>IVA del 15%</strong> según normativa.</li>
                        <li>• Las cantidades están validadas contra el inventario disponible.</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm border-0 bg-white">
                <div class="card-header bg-dark text-white py-2">
                    <h6 class="mb-0 text-center fw-bold">Resumen de Liquidación</h6>
                </div>
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted">Subtotal:</span>
                        <div style="width: 160px;">
                            <input type="text"
                                   class="form-control form-control-sm text-end bg-light font-monospace fw-semibold"
                                   value="@($"$ {Order.Subtotal:N2}")"
                                   readonly />
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted">IVA (15%):</span>
                        <div style="width: 160px;">
                            <input type="text"
                                   class="form-control form-control-sm text-end bg-light font-monospace fw-semibold"
                                   value="@($"$ {Order.Vat:N2}")"
                                   readonly />
                        </div>
                    </div>

                    <hr class="my-2" />

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="fs-5 fw-bold text-dark">Total Factura:</span>
                        <div style="width: 160px;">
                            <input type="text"
                                   class="form-control text-end bg-light font-monospace fs-5 fw-bold text-success border-success"
                                   value="@($"$ {Order.Total:N2}")"
                                   readonly />
                        </div>
                    </div>

                    <button class="btn btn-success btn-lg w-100 shadow"
                            type="submit"
                            disabled="@(Order.OrderDetails.Count == 0 || string.IsNullOrWhiteSpace(Order.CustomerId))">
                        💳 Facturar / Crear Orden
                    </button>
                </div>
            </div>
        </div>
    </div>
</EditForm>

<!-- Modales de Búsqueda -->
<CustomerSearchModal @bind-IsOpen="IsCustomerModalOpen"
                     OnCustomerSelected="OnCustomerSelected" />

<ProductSearchModal @bind-IsOpen="IsProductModalOpen"
                    Title="@ProductModalTitle"
                    OnProductSelected="OnProductSelected" />
