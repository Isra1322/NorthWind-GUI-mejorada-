@page "/user/logout"
@using NorthWind.Membership.Frontend.RazorViews.AuthenticationStateProviders
@inject JWTAuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Cerrar sesión</PageTitle>

<div class="card p-4 mx-auto mt-4" style="max-width: 400px;">
    <h4>Cerrar sesión</h4>
    <p>¿Estás seguro de que deseas cerrar tu sesión?</p>
    <button class="btn btn-primary" @onclick="CloseSession">
        Cerrar sesión
    </button>
</div>

@code {
    private async Task CloseSession()
    {
        await AuthenticationStateProvider.LogoutAsync();
        NavigationManager.NavigateTo("/");
    }
}
