@using Microsoft.AspNetCore.Components.Authorization

<AuthorizeView>
    <Authorized>
        <span class="navbar-text me-3">
            @GetUserName(context)
        </span>
        <a class="btn btn-outline-secondary btn-sm" href="user/logout">Cerrar sesión</a>
    </Authorized>
    <NotAuthorized>
        <a class="btn btn-outline-primary btn-sm me-2" href="user/register">Crear cuenta</a>
        <a class="btn btn-outline-primary btn-sm" href="user/login">Iniciar sesión</a>
    </NotAuthorized>
</AuthorizeView>

@code {
    private string GetUserName(AuthenticationState context) =>
        context.User.Claims
            .Where(c => c.Type == "FullName")
            .Select(c => c.Value)
            .FirstOrDefault() ?? context.User.Identity?.Name ?? string.Empty;
}
