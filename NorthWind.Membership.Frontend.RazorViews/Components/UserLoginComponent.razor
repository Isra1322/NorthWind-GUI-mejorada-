@using NorthWind.Membership.Frontend.RazorViews.ViewModels
@using NorthWind.RazorComponents.Validators

<EditForm Model="ViewModel" OnValidSubmit="ViewModel.Login">
    <ModelValidator Validator="ViewModel.Validator" @ref="ViewModel.ModelValidatorComponentReference" />
    <ValidationSummary />

    <div class="form-group mb-3">
        <label for="Email">Correo electrónico</label>
        <InputText id="Email" class="form-control" placeholder="Correo electrónico" @bind-Value="ViewModel.Email" />
        <ValidationMessage For="@(() => ViewModel.Email)" />
    </div>

    <div class="form-group mb-3">
        <label for="Password">Contraseña</label>
        <InputText id="Password" class="form-control" placeholder="Contraseña" type="password" @bind-Value="ViewModel.Password" />
        <ValidationMessage For="@(() => ViewModel.Password)" />
    </div>

    <div class="row p-3">
        <div class="col">
            <button type="submit" class="btn btn-primary">Iniciar sesión</button>
        </div>
    </div>
</EditForm>

@code {
    [Parameter]
    public UserLoginViewModel ViewModel { get; set; } = default!;
}
